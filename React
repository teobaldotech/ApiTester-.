import React, { useEffect, useState } from "react";

export default function ApiTester() {
  const [url, setUrl] = useState("");
  const [method, setMethod] = useState("GET");

  const [headers, setHeaders] = useState(
    '{\n  "Content-Type": "application/json"\n}'
  );

  const [body, setBody] = useState(
    '{\n  "nome": "Teste"\n}'
  );

  const [token, setToken] = useState("");

  const [response, setResponse] = useState("");
  const [status, setStatus] = useState("");
  const [responseTime, setResponseTime] = useState("");
  const [responseSize, setResponseSize] = useState("");
  const [loading, setLoading] = useState(false);

  const [responseHeaders, setResponseHeaders] = useState({});
  const [history, setHistory] = useState([]);

  // load history safely (avoid SSR crash)
  useEffect(() => {
    try {
      const saved = localStorage.getItem("api-history");
      if (saved) setHistory(JSON.parse(saved));
    } catch {}
  }, []);

  useEffect(() => {
    try {
      localStorage.setItem("api-history", JSON.stringify(history));
    } catch {}
  }, [history]);

  const sendRequest = async () => {
    let timeoutId;
    const controller = new AbortController();

    try {
      setLoading(true);
      setResponse("");
      setStatus("");
      setResponseTime("");
      setResponseSize("");
      setResponseHeaders({});

      if (!url.trim()) throw new Error("Informe uma URL");

      try {
        new URL(url);
      } catch {
        throw new Error("URL inválida");
      }

      let parsedHeaders = {};
      try {
        parsedHeaders = JSON.parse(headers);
      } catch {
        throw new Error("Headers JSON inválido");
      }

      if (token.trim()) {
        parsedHeaders.Authorization = `Bearer ${token}`;
      }

      const methodsWithBody = ["POST", "PUT", "PATCH", "DELETE"];

      const options = {
        method,
        headers: parsedHeaders,
        signal: controller.signal,
      };

      if (methodsWithBody.includes(method)) {
        const contentType = parsedHeaders["Content-Type"] || "";

        if (contentType.includes("application/json")) {
          try {
            JSON.parse(body);
          } catch {
            throw new Error("Body JSON inválido");
          }
        }

        if (body.trim()) {
          options.body = body;
        }
      }

      timeoutId = setTimeout(() => {
        controller.abort();
      }, 10000);

      const start = performance.now();

      const res = await fetch(url, options);

      const end = performance.now();
      clearTimeout(timeoutId);

      setResponseTime(`${Math.round(end - start)} ms`);
      setStatus(`${res.status} ${res.statusText}`);

      // headers
      const headersObj = {};
      res.headers.forEach((v, k) => (headersObj[k] = v));
      setResponseHeaders(headersObj);

      // response body safe parse
      let responseText = "";
      const contentType = res.headers.get("content-type") || "";

      try {
        if (contentType.includes("application/json")) {
          const data = await res.json();
          responseText = JSON.stringify(data, null, 2);
        } else {
          responseText = await res.text();
        }
      } catch {
        responseText = "Erro ao interpretar resposta da API";
      }

      setResponse(responseText);

      const bytes = new TextEncoder().encode(responseText).length;
      setResponseSize(`${bytes} bytes`);

      setHistory((prev) => [
        {
          id: Date.now(),
          method,
          url,
          status: res.status,
          date: new Date().toLocaleString(),
        },
        ...prev.slice(0, 19),
      ]);
    } catch (error) {
      clearTimeout(timeoutId);

      let message = error.message;

      if (error.name === "AbortError") {
        message = "Timeout: a API demorou mais de 10 segundos.";
      }

      if (error instanceof TypeError) {
        message = "Falha de rede ou CORS bloqueado pelo navegador.";
      }

      setStatus("Erro");
      setResponse(message);
    } finally {
      clearTimeout(timeoutId);
      setLoading(false);
    }
  };

  const copyResponse = async () => {
    try {
      await navigator.clipboard.writeText(response || "");
      alert("Resposta copiada!");
    } catch {
      alert("Não foi possível copiar.");
    }
  };

  const clearAll = () => {
    setResponse("");
    setStatus("");
    setResponseTime("");
    setResponseSize("");
    setResponseHeaders({});
  };

  const clearHistory = () => {
    setHistory([]);
    localStorage.removeItem("api-history");
  };

  const getStatusColor = () => {
    if (status === "Erro") return "#ef4444";

    const code = Number(status.split(" ")[0]);

    if (Number.isNaN(code)) return "#64748b";
    if (code >= 200 && code < 300) return "#22c55e";
    if (code >= 400 && code < 500) return "#f59e0b";
    if (code >= 500) return "#ef4444";

    return "#64748b";
  };

  return (
    <div style={styles.body}>
      <div style={styles.container}>
        <h1 style={styles.title}>🚀 API Tester React Pro</h1>

        <input
          style={styles.input}
          placeholder="https://api.exemplo.com"
          value={url}
          onChange={(e) => setUrl(e.target.value)}
        />

        <select
          style={styles.select}
          value={method}
          onChange={(e) => setMethod(e.target.value)}
        >
          <option>GET</option>
          <option>POST</option>
          <option>PUT</option>
          <option>PATCH</option>
          <option>DELETE</option>
        </select>

        <input
          style={styles.input}
          placeholder="JWT Token (Opcional)"
          value={token}
          onChange={(e) => setToken(e.target.value)}
        />

        <h3>Headers</h3>
        <textarea
          style={styles.textarea}
          value={headers}
          onChange={(e) => setHeaders(e.target.value)}
        />

        {method !== "GET" && (
          <>
            <h3>Body</h3>
            <textarea
              style={styles.textarea}
              value={body}
              onChange={(e) => setBody(e.target.value)}
            />
          </>
        )}

        <button style={styles.button} disabled={loading} onClick={sendRequest}>
          {loading ? "Enviando..." : "Enviar Requisição"}
        </button>

        <button style={{ ...styles.button, background: "#10b981" }} onClick={copyResponse}>
          📋 Copiar
        </button>

        <button style={{ ...styles.button, background: "#ef4444" }} onClick={clearAll}>
          🧹 Limpar
        </button>

        <button style={{ ...styles.button, background: "#f97316" }} onClick={clearHistory}>
          🗑 Histórico
        </button>

        {status && (
          <div style={{ ...styles.status, borderLeft: `6px solid ${getStatusColor()}` }}>
            <strong>Status:</strong> {status}
          </div>
        )}

        {responseTime && <div style={styles.status}>⏱ {responseTime}</div>}
        {responseSize && <div style={styles.status}>📦 {responseSize}</div>}

        {Object.keys(responseHeaders).length > 0 && (
          <div style={styles.responseBox}>
            <h3>Headers</h3>
            <pre style={styles.pre}>
              {JSON.stringify(responseHeaders, null, 2)}
            </pre>
          </div>
        )}

        {history.length > 0 && (
          <div style={styles.responseBox}>
            <h3>Histórico</h3>
            {history.map((h) => (
              <div key={h.id} style={styles.historyItem}>
                <strong>{h.method}</strong> - {h.status}
                <div>{h.url}</div>
                <small>{h.date}</small>
              </div>
            ))}
          </div>
        )}

        <div style={styles.responseBox}>
          <h3>Resposta</h3>
          <pre style={styles.pre}>
            {response || "A resposta aparecerá aqui..."}
          </pre>
        </div>
      </div>
    </div>
  );
}

const styles = {
  body: {
    minHeight: "100vh",
    background: "#0f172a",
    color: "#fff",
    display: "flex",
    justifyContent: "flex-start",
    alignItems: "center",
    flexDirection: "column",
    padding: 20,
    fontFamily: "Arial",
  },
  container: {
    width: "100%",
    maxWidth: 1000,
    background: "#1e293b",
    padding: 25,
    borderRadius: 15,
  },
  title: { textAlign: "center" },
  input: { width: "100%", padding: 10, marginBottom: 10 },
  select: { width: "100%", padding: 10, marginBottom: 10 },
  textarea: { width: "100%", minHeight: 120, marginBottom: 10 },
  button: {
    width: "100%",
    padding: 12,
    marginBottom: 8,
    background: "#3b82f6",
    color: "#fff",
    border: "none",
    borderRadius: 8,
    cursor: "pointer",
  },
  status: {
    background: "#334155",
    padding: 10,
    marginBottom: 8,
    borderRadius: 6,
  },
  responseBox: {
    background: "#0f172a",
    padding: 10,
    marginTop: 10,
    borderRadius: 8,
  },
  pre: {
    whiteSpace: "pre-wrap",
    wordBreak: "break-word",
  },
  historyItem: {
    padding: 8,
    borderBottom: "1px solid #334155",
  },
};
